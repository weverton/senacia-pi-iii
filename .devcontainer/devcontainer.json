{
  "name": "Python 3.11",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.14-bookworm",
  "features": {
    "ghcr.io/jsburckhardt/devcontainer-features/ruff:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python", 
        "mechatroner.rainbow-csv", 
        "marimo-team.vscode-marimo",
        "charliermarsh.ruff",
         "kevinrose.vsc-python-indent"
      ],
      "settings": {
        "python.defaultInterpreterPath": "./.venv/bin/python",
        "python.packageManager": "uv",
        "marimo.browserType": "embedded" 
      }
    }
  },
  "mounts": [
    "source=D:/hf_cache,target=/root/.cache/huggingface,type=bind",
  ],
  "runArgs": [
    "--gpus", "all",
    "--name", "hf_marimo_cv",
    "--env-file", ".devcontainer/.env",
    "--shm-size", "8g",
    "--network", "host"
  ],
  "forwardPorts": [2718, 8000, 5173],  
  "postCreateCommand": "apt update && apt install libgl1 && uv init --no-readme && uv venv --clear && uv add torchtext torchdata GPUtil IPython ultralytics opencv-python scikit-learn insightface python-dotenv 'uvicorn[standard]'",
  "remoteUser": "root"
}